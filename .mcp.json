{
  "mcpServers": {
    "playwright": {
      "command": "node",
      "args": [
        ".claude/playwright-mcp-start.cjs",
        "main",
        "--viewport-size=1600,750",
        "--config",
        ".claude/playwright-mcp-config.json"
      ]
    },
    "playwright-mobile": {
      "command": "node",
      "args": [
        ".claude/playwright-mcp-start.cjs",
        "mobile",
        "--device=Pixel 7",
        "--isolated",
        "--config",
        ".claude/playwright-mcp-config.json"
      ]
    }
  }
}
